# Copy to .env. Docker Compose and Craft both read it.
COMPOSE_FILE=compose.dev.yml
COMPOSE_PROJECT_NAME=mysite
# Uncomment to start the Vite dev server on every `docker compose up`.
# COMPOSE_PROFILES=vite

# Host ports (change them to run several projects at once).
WEB_PORT=8080
VITE_PORT=5173
DB_PORT=3306
MAILPIT_PORT=8025

# Linux hosts only: output of `id -u` / `id -g`.
USER_ID=
GROUP_ID=

CRAFT_APP_ID=
CRAFT_SECURITY_KEY=
